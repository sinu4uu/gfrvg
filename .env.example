# Web Portal Environment Configuration (Production Template)

# Firebase Configuration (Client-side Google Auth & Sync)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Payment Gateway Configuration
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Server Port (Auto-injected on cloud hosts like Render/Heroku)
PORT=5000

# Telegram Bot Integration & Admin
BOT_TOKEN=your_bot_token_here
ADMIN_ID=your_telegram_id_here
TELEGRAM_REQUIRED_CHANNELS=@channel1,@channel2

# GitHub Private Repo Auto-Backup (Runs every 6 hours)
GITHUB_BACKUP_TOKEN=ghp_your_github_token_here
GITHUB_BACKUP_REPO=username/private_repo_name

